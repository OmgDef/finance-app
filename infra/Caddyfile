{
	admin off
	auto_https disable_redirects
	local_certs
	skip_install_trust
	default_sni {$TETA_BIND_IP}
	log {
		level WARN
	}
}

{$TETA_SCHEME:https}://{$TETA_BIND_IP}:{$TETA_API_PORT} {
	bind {$TETA_LISTEN_IP:0.0.0.0}
	@mobile path /api/v1/health /api/v1/support /api/v1/auth/* /api/v1/me /api/v1/me/time-zone /api/v1/me/profile /api/v1/me/profile/* /api/v1/accounts /api/v1/accounts/* /api/v1/transactions /api/v1/transactions/* /api/v1/commands/* /api/v1/categories /api/v1/statistics /api/v1/exchange-rates /api/v1/schedule-rules /api/v1/schedule-rules/* /api/v1/schedule-occurrences /api/v1/schedule-occurrences/*
	handle @mobile {
		reverse_proxy {$TETA_UPSTREAM:api:3000} {
			# Browsers share cookies between ports on the same host.
			header_up -Cookie
			header_down -Set-Cookie
		}
	}
	handle {
		respond 404
	}
}

{$TETA_SCHEME:https}://{$TETA_BIND_IP}:{$TETA_ADMIN_PORT} {
	bind {$TETA_LISTEN_IP:0.0.0.0}
	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
	}
	handle /api/v1/admin/* {
		reverse_proxy {$TETA_UPSTREAM:api:3000}
	}
	handle /api/* {
		respond 404
	}
	@admin_pages {
		method GET HEAD
		path /users /users/* /audit /audit/ /support /support/
	}
	handle @admin_pages {
		root * {$TETA_ADMIN_ROOT:/srv}
		rewrite * /index.html
		file_server
	}
	handle {
		root * {$TETA_ADMIN_ROOT:/srv}
		file_server
	}
}
